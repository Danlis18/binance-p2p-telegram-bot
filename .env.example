# Required: Telegram token from @BotFather
BOT_TOKEN=123456789:replace_me

# Optional access restriction. Comma-separated Telegram numeric user IDs.
# Leave empty to allow everyone.
ALLOWED_USER_IDS=

# Defaults
DEFAULT_FIAT=UAH
DEFAULT_MODE=BUY
DEFAULT_RATE_STRATEGY=TOP3
MIN_COMPLETION_RATE=0.90

# Binance public P2P API
BINANCE_BASE_URL=https://www.binance.com
BINANCE_TIMEOUT_MS=8000
BINANCE_RETRIES=2

# Runtime
PORT=3000
LOG_LEVEL=info
